PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=https://echofourai.com,https://www.echofourai.com
TRUST_PROXY=1
LEADS_ENCRYPTION_KEY=base64-encoded-32-byte-key
LEAD_RETENTION_DAYS=365
GENERAL_RATE_LIMIT_MAX=240
CHAT_RATE_LIMIT_MAX=180
LEAD_RATE_LIMIT_MAX=5
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@example.com
SMTP_PASS=replace-with-secret
LEAD_NOTIFICATION_FROM=EchoFour AI <hello@echofourai.com>
LEAD_NOTIFICATION_TO=hello@echofourai.com
